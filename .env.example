# Copy this file to .env and fill in real values.
# .env must NEVER be committed (see .gitignore).

API_BASE_URL=https://api.restcountries.com/v5

# REST Countries now requires an API key (free "Academic" plan,
# obtained at restcountries.com -> "Get an API key"). Sent as
# Authorization: Bearer <API_KEY>, see src/staging.py.
API_KEY=your-secret-key-here
